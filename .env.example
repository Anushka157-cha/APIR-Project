# PostgreSQL
DATABASE_URL=postgresql+asyncpg://apir:apir@postgres:5432/apir
POSTGRES_USER=apir
POSTGRES_PASSWORD=apir
POSTGRES_DB=apir

# Redis
REDIS_URL=redis://redis:6379/0

# LLM (optional — without a key the system uses evidence-based heuristic analysis)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_URL=postgresql+asyncpg://apir:apir@postgres:5432/apir

# OpenTelemetry
OTEL_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=apir

# Auth
JWT_SECRET=change-me-in-local-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Incident detection
DETECTION_INTERVAL_SECONDS=8
LATENCY_P95_THRESHOLD_MS=800
ERROR_RATE_THRESHOLD=0.05
ZSCORE_THRESHOLD=3.0
TRAFFIC_ZSCORE_THRESHOLD=3.5
AUTO_EXECUTE_LOW_RISK=false
BASELINE_WINDOW_MINUTES=30
VERIFICATION_SAMPLES=4
VERIFICATION_SAMPLE_INTERVAL_SECONDS=5

# Safety controls
DRY_RUN_MODE=false
REMEDIATION_TIMEOUT_SECONDS=60
ENABLE_ROLLBACK=true

# Service URLs
GATEWAY_URL=http://gateway:8080
ORDER_URL=http://order:8081
PAYMENT_URL=http://payment:8082
INVENTORY_URL=http://inventory:8083
NOTIFICATION_URL=http://notification:8084
PROMETHEUS_URL=http://prometheus:9090
APIR_API_URL=http://backend:8000

# Demo users are seeded on first boot (change after first login)
DEMO_ADMIN_PASSWORD=admin123
DEMO_SRE_PASSWORD=sre123
DEMO_VIEWER_PASSWORD=viewer123
